---
// The end of a component's docs page: the previous and next components in the nav's order, so a reader can walk the
// whole kit page by page. The first page has no previous and the last no next.
import { COMPONENTS } from "./catalogue"

interface Props {
  current: string
}
const { current } = Astro.props
const at = COMPONENTS.findIndex((c) => c.name === current)
const prev = at > 0 ? COMPONENTS[at - 1] : undefined
const next = at >= 0 ? COMPONENTS[at + 1] : undefined
---

<nav aria-label="Previous and next" class="docs-pager">
  <ul>
    <li>
      {prev && (
        <a href={`/docs/components/${prev.name}`} rel="prev">
          <span class="caps">← Previous</span>
          <span class="docs-pager-title">{prev.title}</span>
        </a>
      )}
    </li>
    <li class="docs-pager-next">
      {next && (
        <a href={`/docs/components/${next.name}`} rel="next">
          <span class="caps">Next →</span>
          <span class="docs-pager-title">{next.title}</span>
        </a>
      )}
    </li>
  </ul>
</nav>
