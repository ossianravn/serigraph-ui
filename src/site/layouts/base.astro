---
// The site's page frame: the appearance before first paint, then the poster: a paper mat (poster mode) around the
// canvas, with the header on the canvas and the footer on a cloud-coloured ground.
import "@/site/styles.css"
import "@/site/site.css"
import { appearanceScript } from "@/serigraph/theme/appearance-script"
import { Folly } from "@/serigraph/extras/folly"
import { siteAppearance } from "@/site/appearance"

interface Props {
  title: string
  description: string
}
const { title, description } = Astro.props
const fullTitle = title === "Serigraph" ? title : `${title} · Serigraph`
const links = [
  ["Specimen", "/specimen"],
  ["Letters", "/letters"],
  ["Press", "/press"],
  ["Components", "/docs"],
  ["Blocks", "/docs/blocks"],
  ["Studio", "/studio"],
  ["Meridian", "/meridian"],
]
import ShareMeta from "@/site/share-meta.astro"
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href="/fonts/serigraph-display.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/serigraph-sans-bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <ShareMeta title={fullTitle} description={description} />
    <script is:inline set:html={appearanceScript(siteAppearance)} />
  </head>
  <body>
    <a class="skip caps" href="#main">
      Skip to content
    </a>
    <div class="mat">
      <div class="frame canvas">
        <header class="site-header">
          <a class="caps wordmark" href="/">
            Serigraph
          </a>
          <nav class="site-nav caps" aria-label="Sections">
            <ul>
              {links.map(([label, href]) => (
                <li>
                  <a href={href}>{label}</a>
                </li>
              ))}
            </ul>
          </nav>
        </header>
        <main id="main">
          <slot />
        </main>
        <Folly template="band" seed={title} className="site-band" />
        <footer class="ground site-footer caps">
          Serigraph{" "}
          <span class="sep" aria-hidden="true">
            •
          </span>{" "}
          MIT
        </footer>
      </div>
    </div>
  </body>
</html>
