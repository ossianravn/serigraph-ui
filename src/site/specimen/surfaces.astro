---
import { Lettering } from "@/serigraph/extras/lettering"
import { Folly } from "@/serigraph/extras/folly"
// Paper, ink and the spots, then the surfaces and marks every part is built from, as a specimen sheet: one row per
// material, its name on the left and its samples centred on one line beside it. Planes in their tones, a field in the
// tint of what it sits on, the pressed shade and the focus ring, stipple, louvers and the poster's small details.
const spots = [
  "sky",
  "cornflower",
  "seafoam",
  "pistachio",
  "marigold",
  "coral",
  "bubblegum",
  "lilac",
  "rose",
]
const title = (value: string) => value.charAt(0).toUpperCase() + value.slice(1)
---

<section class="section section-after-ground" id="surfaces" aria-labelledby="h-surfaces">
  <Folly template="arcade" className="arcade-edge" />
  <Lettering as="h2" className="section-title" id="h-surfaces">Surfaces</Lettering>
  <p class="section-lede">
    Flat colour laid on colour, one fine line, a printed grain under the
    content. Nothing is shadowed, extruded or translucent.
  </p>

  <dl class="sheet">
    <div class="sheet-row">
      <dt class="caps">Paper <span class="sep">•</span> ink <span class="sep">•</span> spots</dt>
      <dd class="spots">
        <span class="spot spot-paper caps">Paper</span>
        <span class="spot spot-ink caps">Ink</span>
        {
          spots.map((spot) => (
            <span class="spot caps" style={`background-color: var(--${spot})`}>
              {title(spot)}
            </span>
          ))
        }
      </dd>
    </div>

    <div class="sheet-row">
      <dt class="caps">Planes</dt>
      <dd class="sheet-samples">
        {
          ["1", "2", "3", "4"].map((tone) => (
            <div class="plane plane-sample" data-tone={tone}>
              <span class="caps">Tone {tone}</span>
            </div>
          ))
        }
      </dd>
    </div>

    <div class="sheet-row">
      <dt class="caps">Fields <span class="sep">•</span> tinted from beneath</dt>
      <dd class="sheet-samples">
        <input
          class="field-fill sample-field"
          aria-label="On the canvas"
          value="ada@meridian.org"
        />
        <div class="plane field-on-plane" data-tone="1">
          <input
            class="field-fill sample-field"
            aria-label="On a plane"
            value="ada@meridian.org"
          />
        </div>
      </dd>
    </div>

    <div class="sheet-row">
      <dt class="caps">Pressed <span class="sep">•</span> focus</dt>
      <dd class="sheet-samples">
        <span class="sample-pill caps" style="--fill: var(--action)">Book</span>
        <span class="sample-pill pressed-shade caps" style="--fill: var(--action)"
          >Pressed</span
        >
        <span class="sample-pill focus-ring caps" style="--fill: var(--plane-2)"
          >Focus</span
        >
      </dd>
    </div>

    <div class="sheet-row">
      <dt class="caps">Stipple <span class="sep">•</span> louvers</dt>
      <dd class="sheet-samples">
        <span class="medallion" aria-hidden="true"></span>
        <span class="louver-bar" aria-hidden="true"><span class="louvers"></span></span>
        <span class="caps">
          Meridian <span class="sep">•</span> The dome <span class="sep">•</span>
          November 15<span class="ord">th</span>
        </span>
      </dd>
    </div>
  </dl>
</section>
