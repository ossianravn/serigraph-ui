---
// The drawing library's front page: each collection with six of its drawings and a way into the rest. A collection's
// own page (drawings/[collection].astro) shows all of it, so no page draws the whole library at once. Every drawing
// opens in the Press, where its seed rerolls.
import Base from "@/site/layouts/base.astro"
import { Lettering } from "@/serigraph/extras/lettering"
import { OBJECTS } from "@/serigraph/follies"
import ObjectGrid from "@/site/drawings/object-grid.astro"
import { COLLECTION_PAGES } from "@/site/drawings/collections"
import "@/site/drawings/drawings.css"

const count = Object.keys(OBJECTS).length
---

<Base
  title="Drawings"
  description="The Follies library: seeded drawings of surreal architecture, the sky, instruments, gardens, travel and the stage, flat in spot colours inside one fine ink line."
>
  <div class="drawings">
    <header class="drawings-head">
      <Lettering as="h1" className="drawings-title">
        Drawings
      </Lettering>
      <p class="drawings-lede">
        {count} objects in seven collections, each drawn from a seed and
        reprinted in every colourway. Open one in <a href="/press">the Press</a>{" "}
        to reroll it, copy its SVG or take the line of code that draws it.
      </p>
    </header>
    {COLLECTION_PAGES.map((c) => (
      <section class="drawings-collection" aria-labelledby={`c-${c.key}`}>
        <div class="drawings-collection-head">
          <h2 id={`c-${c.key}`} class="drawings-collection-title">
            <Lettering as="a" href={c.href}>
              {c.title}
            </Lettering>
          </h2>
          <p class="drawings-collection-lead">{c.lead}</p>
        </div>
        <ObjectGrid objects={c.picks} />
        <p class="drawings-more">
          <a href={c.href}>
            All {c.objects.length} drawings in {c.title.toLowerCase()}
          </a>
        </p>
      </section>
    ))}
  </div>
</Base>
