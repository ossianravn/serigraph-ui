---
// The Components index: every part with a docs page, by group, each a title and the sentence on what it is for.
import Base from "@/site/layouts/base.astro"
import { Lettering } from "@/serigraph/extras/lettering"
import { GROUPS } from "@/site/docs/catalogue"
import "@/site/docs/docs.css"
---

<Base
  title="Components"
  description="Serigraph's parts: shadcn's names, props and slots on Base UI, printed flat in the colourway's spot colours inside one fine line."
>
  <div class="docs">
    <div class="min-w-0">
      <Lettering as="h1" className="docs-title">
        Components
      </Lettering>
      <p class="docs-lead">
        shadcn's parts with their names, props and slots, printed flat in the
        colourway's spot colours inside one fine line.
      </p>
      <div class="docs-index">
        {GROUPS.map(({ group, items }) => (
          <section aria-labelledby={`g-${group}`}>
            <h2 id={`g-${group}`} class="caps">
              {group}
            </h2>
            <ul>
              {items.map(({ name, title, description }) => (
                <li>
                  <a href={`/docs/components/${name}`}>{title}</a>
                  <p>{description}</p>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </div>
</Base>
