---
// The drawings: the object library as a procession through an arcade's niches, full width, and the ways into the
// library and the Press.
import { Folly } from "@/serigraph/extras/folly"
import { OBJECTS } from "@/serigraph/follies"
import SectionHead from "./section-head.astro"

const count = Object.keys(OBJECTS).length
---

<section class="section home-section" aria-labelledby="h-drawings">
  <SectionHead
    id="h-drawings"
    title="Follies"
    href="/drawings"
    link="Every drawing"
  >
    {count} seeded objects of architecture, sky, instruments and gardens, and
    the scenes composed from them. Every drawing reprints in each colourway.
  </SectionHead>
</section>
<Folly template="procession" seed="home" className="home-procession" />
