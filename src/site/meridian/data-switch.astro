---
// The dev-only data switch: plain chrome at the foot of the window, not part of the design under test. Each choice is a
// page of its own, so a reload keeps it.
interface Props {
  set: string
  page: string
}
const { set, page } = Astro.props
const SETS = [
  ["demo", "Demo data"],
  ["worst", "Worst case"],
  ["empty", "Empty"],
  ["one", "One"],
]
const PAGES = [
  ["tonight", "Tonight"],
  ["settings", "Settings"],
]
---

<nav class="data-switch" aria-label="Data">
  {SETS.map(([key, label]) => (
    <a
      href={`/meridian/data/${key}/${page}`}
      aria-current={key === set ? "true" : undefined}
    >
      {label}
    </a>
  ))}
  <span aria-hidden="true">|</span>
  {PAGES.map(([key, label]) => (
    <a
      href={`/meridian/data/${set}/${key}`}
      aria-current={key === page ? "true" : undefined}
    >
      {label}
    </a>
  ))}
</nav>

<style>
  .data-switch {
    position: fixed;
    bottom: 12px;
    left: 50%;
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: 999px;
    background: #e4e4e7;
    color: #18181b;
    font:
      12px/1 system-ui,
      sans-serif;
    translate: -50% 0;
  }
  .data-switch a {
    padding: 6px 10px;
    border-radius: 999px;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
  }
  .data-switch a[aria-current] {
    background: #fff;
  }
  .data-switch span {
    color: #a1a1aa;
  }
</style>
