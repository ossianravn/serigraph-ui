---
// Meridian tonight's content, from one data set: the night in one line, what to know about the weather, the seats you
// hold and the sessions to book (the page's one island), and beside them what is up in the sky and when to look. The
// page renders the real data; the dev-only data switch renders the worst case and the edges.
import { Lettering } from "@/serigraph/extras/lettering"
import { Folly } from "@/serigraph/extras/folly"
import { Drawing } from "@/serigraph/extras/drawing"
import { Alert, AlertDescription, AlertTitle } from "@/serigraph/ui/alert"
import { Tonight } from "./tonight"
import type { Dataset } from "./worst-case"

type Props = Dataset

// Each kind of thing in the sky, drawn from the library beside its name.
const SKY_DRAWING = {
  planet: "ringed-planet",
  moon: "crescent-moon",
  galaxy: "star-cluster",
  cluster: "star-cluster",
} as const
const { night, sky, sessions, visitor } = Astro.props
---

<div class="mer-page">
  <header class="mer-hero">
    <div>
      <Lettering as="h1" className="mer-title">
        Tonight
      </Lettering>
      <p class="mer-lede">
        {night.date}. Dark from {night.darkFrom}, clear until {night.clearUntil}
        .
      </p>
    </div>
    <Folly
      template="observatory"
      seed={night.date}
      label="A telescope on a platform in the clouds under a ringed planet and the moon"
      className="mer-window"
    />
  </header>
  <div class="mer-board">
    <div class="mer-main">
      <Alert data-tone="4">
        <AlertTitle>Clouds expected after {night.clearUntil}</AlertTitle>
        <AlertDescription>
          The deck closes at 22:45. Telescope time booked after that moves to
          Friday at no cost.
        </AlertDescription>
      </Alert>
      <Tonight sessions={sessions} visitor={visitor} client:idle />
    </div>
    <aside class="plane mer-sky" data-tone="1" aria-labelledby="sky">
      <h2 id="sky">The sky tonight</h2>
      <dl>
        <div>
          <dt>Dark from</dt>
          <dd>{night.darkFrom}</dd>
        </div>
        <div>
          <dt>Moonrise, {night.moon.lit}% lit</dt>
          <dd>{night.moon.rises}</dd>
        </div>
        <div>
          <dt>Seeing</dt>
          <dd>{night.seeing} of 5</dd>
        </div>
      </dl>
      <ul>
        {sky.map((object) => (
          <li>
            <span>
              <Drawing
                object={SKY_DRAWING[object.kind]}
                seed={object.name}
                className="mer-sky-icon"
              />{" "}
              {object.name}
              <span class="mer-sky-where">{object.where}</span>
            </span>
            <span class="mer-time">{object.best}</span>
          </li>
        ))}
      </ul>
    </aside>
  </div>
</div>
