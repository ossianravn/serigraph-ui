---
// The specimen: Serigraph's materials on one print. The colourways, the surfaces and marks, and the voices with their
// Golden Ratio scale, all from the kit; the appearance panel sits with the colourways. The static prototype the style was agreed on stays
// in specimen/.
import Base from "@/site/layouts/base.astro"
import { Lettering } from "@/serigraph/extras/lettering"
import { Folly } from "@/serigraph/extras/folly"
import Colourways from "@/site/specimen/colourways.astro"
import Surfaces from "@/site/specimen/surfaces.astro"
import Voices from "@/site/specimen/voices.astro"
import "@/site/specimen/specimen.css"
import "@/site/specimen/sheet.css"
---

<Base
  title="Specimen"
  description="A shadcn/ui kit in the style of a late-1970s silkscreen gig poster drawn with a technical pen: the specimen of its colourways, surfaces and voices."
>
  <div class="hero">
    <Lettering as="h1" className="hero-title">
      Specimen
    </Lettering>
    <p class="hero-lede">
      A shadcn/ui kit printed like a silkscreen gig poster: flat, luminous spot
      colours laid one on another, one fine ink line, and a paper mat around the
      canvas.
    </p>
    <Folly template="city" seed="specimen" className="hero-art" />
  </div>
  <Colourways />
  <Surfaces />
  <Voices />
</Base>
