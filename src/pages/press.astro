---
// The Press: Follies, rerolled. Every scene and every object in the library, any seed, any colourway, and the SVG
// or the code to take away; then the formats and the motifs on their own. The drawings pages link here with
// ?object=…&seed=…; until the island has read that, the drawing is hidden, so a linked object never flashes the city.
import Base from "@/site/layouts/base.astro"
import { Lettering } from "@/serigraph/extras/lettering"
import { Folly } from "@/serigraph/extras/folly"
import { Motif } from "@/serigraph/extras/motif"
import { Press } from "@/site/press/press"
import "@/site/press/press.css"
---

<Base
  title="The Press"
  description="Follies, Serigraph's seeded drawings: every scene and every object in the library, any seed, any colourway, and the SVG or code to take away."
>
  <script is:inline>
    if (/[?&](object|template)=/.test(location.search))
      document.documentElement.classList.add("press-pending")
  </script>
  <div class="press-hero">
    <Lettering as="h1" className="press-title">
      The Press
    </Lettering>
    <p class="press-lede">
      Draw any scene or any object from the <a href="/drawings">library</a> from
      a seed of your own, in any colourway, and take away its SVG or the line of
      code that draws it.
    </p>
  </div>
  <section class="section press-section" aria-label="The press">
    <Press client:load />
  </section>
  <section class="section" aria-labelledby="h-formats">
    <Lettering as="h2" className="section-title" id="h-formats">
      Formats
    </Lettering>
    <div class="formats">
      <figure>
        <Folly
          template="window"
          seed="terrace"
          className="arch-frame format-window"
        />
        <figcaption class="caps">Window</figcaption>
      </figure>
      <figure>
        <Folly template="medallion" seed="ada" className="format-medallion" />
        <figcaption class="caps">Medallion</figcaption>
      </figure>
      <figure>
        <Folly
          template="medallion"
          seed="saturn"
          className="format-medallion"
        />
        <figcaption class="caps">Medallion</figcaption>
      </figure>
      <figure>
        <Folly template="doorway" seed="empty" className="format-doorway" />
        <figcaption class="caps">Doorway</figcaption>
      </figure>
    </div>
  </section>
  <section class="section" aria-labelledby="h-motifs">
    <Lettering as="h2" className="section-title" id="h-motifs">
      Motifs
    </Lettering>
    <div class="formats">
      {(
        [
          ["pinwheel", "Pinwheel"],
          ["sparkle", "Sparkle"],
          ["cloud", "Cloud"],
          ["archway", "Archway"],
        ] as const
      ).map(([kind, name]) => (
        <figure>
          <Motif kind={kind} seed="press" className="motif-sample" />
          <figcaption class="caps">{name}</figcaption>
        </figure>
      ))}
    </div>
    <p class="caps motif-row">
      <Motif kind="sparkle" seed="new" /> New <span class="sep">•</span>
      <Motif kind="pinwheel" seed="tonight" /> Tonight
    </p>
  </section>
</Base>
