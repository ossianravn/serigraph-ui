---
// Dev only: Meridian's screens drawn from the worst case and the edges (empty, one), with a switch at the foot of the
// window. Production builds no pages here.
import Meridian from "@/site/layouts/meridian.astro"
import TonightPage from "@/site/meridian/tonight-page.astro"
import DataSwitch from "@/site/meridian/data-switch.astro"
import { Settings } from "@/site/meridian/settings"
import { DATASETS } from "@/site/meridian/worst-case"

export function getStaticPaths() {
  if (!import.meta.env.DEV) return []
  return Object.keys(DATASETS).flatMap((set) =>
    ["tonight", "settings"].map((page) => ({ params: { set, page } })),
  )
}

const set = Astro.params.set as keyof typeof DATASETS
const page = Astro.params.page as "tonight" | "settings"
const data = DATASETS[set]
---

<Meridian
  title={page === "tonight" ? "Tonight" : "Settings"}
  section={page}
  visitor={data.visitor}
>
  {page === "tonight" ? (
    <TonightPage {...data} />
  ) : (
    <div class="mer-page">
      <Settings visitor={data.visitor} sessions={data.sessions} client:load />
    </div>
  )}
  <DataSwitch set={set} page={page} />
</Meridian>
