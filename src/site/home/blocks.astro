---
// The kit in use: whole pages built from its parts, shown by a slice of one (tonight's programme from the dashboard
// block, printed from the kit's parts at build time, so nothing hydrates), with the way to every block.
import { Badge } from "@/serigraph/ui/badge"
import { buttonVariants } from "@/serigraph/ui/button"
import { Folly } from "@/serigraph/extras/folly"
import { NIGHT, SESSIONS, seatsLeft } from "@/site/sample/observatory"
import SectionHead from "./section-head.astro"

const sessions = SESSIONS.slice(0, 4)
---

<section class="section home-section home-spread" aria-labelledby="h-blocks">
  <div class="home-spread-words">
    <SectionHead
      id="h-blocks"
      title="Blocks"
      href="/docs/blocks"
      link="See every block"
    >
      Whole pages built from the parts, ready to install and make your own: a
      hero, sign-in, a dashboard, settings, pricing, an article and empty
      states.
    </SectionHead>
    <div class="plane home-tonight" data-tone="1">
      <p class="caps">{NIGHT.date}</p>
      <ul>
        {sessions.map((session) => (
          <li>
            <span class="font-mono">{session.starts}</span>
            <span class="home-tonight-title">{session.title}</span>
            {seatsLeft(session) === 0 ? (
              <Badge variant="outline">Full</Badge>
            ) : (
              <Badge variant="secondary" data-tone="3">
                {seatsLeft(session)} left
              </Badge>
            )}
          </li>
        ))}
      </ul>
      <a
        class={buttonVariants({ size: "sm" })}
        href="/docs/blocks#dashboard-01"
      >
        Open the dashboard
      </a>
    </div>
  </div>
  <!-- The observatory the blocks are filled from: the telescope on its platform in the clouds, under tonight's planet and moon. -->
  <Folly
    template="observatory"
    seed="meridian"
    className="home-spread-art home-observatory"
  />
</section>
